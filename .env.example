# Bayana API (copy to `.env.local` and adjust for your backend)
#
# Dev default: requests go to `/api`, proxied by Vite to VITE_API_PROXY_TARGET.
# Production: set an absolute API URL.
# VITE_API_BASE_URL=https://api.joinbayana.com

VITE_API_PROXY_TARGET=http://localhost:8080

# Frontend URL for email verification links (ask backend to use this instead of the API URL)
VITE_APP_URL=http://localhost:5173

# When true, pages should call authApi / onboardingApi / orgApi instead of mocks.
VITE_API_INTEGRATION_ENABLED=false
